{
  "name": "resume-maker-9000",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Nikhil Reddy Avuthu <anr.appcontact@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikhil1920/resumes.git"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev-host": "vite dev --host --port 3000",
    "generate-routes": "tsr generate",
    "build": "pnpm run build:web",
    "build:web": "vite build --mode web && node scripts/prepare-build.mjs web",
    "build:capacitor": "vite build --mode capacitor && node scripts/prepare-build.mjs capacitor",
    "cap:sync": "pnpm run build:capacitor && cap sync",
    "preview": "node scripts/preview-web.mjs",
    "live": "node scripts/live-relay.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify:seo": "pnpm run build:web && pnpm run build:capacitor && node scripts/verify-seo-build.mjs",
    "verify:pdf-preview": "node scripts/verify-preview-pdf.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@dnd-kit/accessibility": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.33",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
